# ==============================================================================
# Japan Tourism Platform - Environment Variables
# ==============================================================================

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Supabase URL (safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Key (safe for client-side)
# Supported names: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY or NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# SERVER-ONLY: Secret / Service Role Key (Never expose in client code)
# Supported names: SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=your-supabase-secret-key

# ------------------------------------------------------------------------------
# Payment Gateway: Safepay Configuration
# ------------------------------------------------------------------------------
SAFEPAY_ENVIRONMENT=sandbox
NEXT_PUBLIC_SAFEPAY_API_KEY=sec_sand_your_safepay_public_api_key

# SERVER-ONLY: Used for creating order trackers, signature checks & refunds
SAFEPAY_SECRET_KEY=your_safepay_secret_key
SAFEPAY_WEBHOOK_SECRET=your_safepay_webhook_secret_key

# ------------------------------------------------------------------------------
# Transactional Email: Resend Configuration
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM_ADDRESS="Japan Travel Bookings <bookings@yourdomain.com>"

# ------------------------------------------------------------------------------
# FX & Multi-Currency Engine
# ------------------------------------------------------------------------------
EXCHANGE_RATE_API_KEY=
